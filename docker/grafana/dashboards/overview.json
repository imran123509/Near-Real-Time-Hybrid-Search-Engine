{
  "uid": "nrt-search-overview",
  "id": null,
  "title": "Near Real-Time Search Engine — Overview",
  "description": "Is the system healthy, how much work is arriving, how fast is it being done, and what is failing. Start here; the other dashboards explain whatever looks wrong.",
  "tags": [
    "near-realtime-search",
    "overview"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "preload": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API ready",
      "description": "The API's readiness check: OpenSearch and Qdrant answered. It is the same check /ready runs, sampled every 10 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "text": {}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hybrid_search_application_ready{service=\"api\"}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
