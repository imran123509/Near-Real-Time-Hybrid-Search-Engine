# Copy to .env for local development and fill in your own values.
# .env is git-ignored; this file is committed, so keep real secrets out of it.

APP_ENV=development
APP_NAME=near-realtime-search

# HTTP server (API only)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL (required) - local development credentials only
DATABASE_URL=postgres://postgres:postgres@localhost:5432/searchdb
# Connection pool
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s

# Kafka (required)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=document-events
KAFKA_CONSUMER_GROUP=near-realtime-search
# Defaults to KAFKA_TOPIC + ".dlq"
KAFKA_DLQ_TOPIC=
KAFKA_WORKERS=10

# OpenSearch (URL required)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=documents

# Qdrant (URL required). Must be the gRPC endpoint, port 6334 by default,
# not the REST endpoint on 6333.
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
# Dimension of stored vectors. Defaults to EMBEDDING_DIMENSION and must match
# it, because Qdrant rejects vectors of any other length.
QDRANT_VECTOR_SIZE=768

# Indexing (consumer only)
INDEXING_WORKERS=10
# Messages buffered across all workers
INDEXING_QUEUE_SIZE=1000
INDEXING_BATCH_SIZE=100
# Total tries per message, including the first
INDEXING_RETRY_ATTEMPTS=3

# Embedding provider (consumer only; the API key is required by the consumer)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# gemini-embedding-2 supports 128-3072; 768, 1536 and 3072 are recommended.
# Changing it, or the model, means re-embedding every stored document.
EMBEDDING_DIMENSION=768
# Upper bound on one embedding request, network round trip included
EMBEDDING_TIMEOUT=10s
