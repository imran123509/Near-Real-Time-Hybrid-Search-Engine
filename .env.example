# Copy to .env and fill in your own values. .env is git-ignored; this file is
# committed, so it holds development placeholders only, never real secrets.
#
# .env has two readers:
#   - docker compose reads it for the credentials and settings the containers
#     need (the "Docker Compose" section, EMBEDDING_*, and a few names);
#   - you, when running a Go service on the host: the application settings
#     below point at the ports the stack publishes on localhost. The services
#     do not read .env themselves; see README.md for loading it into a shell.
# Inside the containers, docker-compose.yml points the services at each other
# by name (postgres, kafka, ...) instead.

# --- Docker Compose ----------------------------------------------------------
# Database owner, used by the application. Keep the password URL-safe, since it
# is embedded in DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=searchdb
# Least-privilege replication role that Debezium connects as.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium

# Host ports the stack publishes. Change one if something already listens on
# it; container-to-container ports are unaffected. The application settings
# below, and the E2E defaults, assume these values.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=29092
CONNECT_HOST_PORT=8083
OPENSEARCH_HOST_PORT=9200
QDRANT_REST_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
API_HOST_PORT=8080

# --- Application ---------------------------------------------------------------
APP_ENV=development
APP_NAME=near-realtime-search
# How long a service waits for its dependencies to accept connections
APP_STARTUP_TIMEOUT=60s
# debug, info, warn or error. debug logs every indexed change and every search.
LOG_LEVEL=info

# HTTP server (API only)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/searchdb?sslmode=disable
# Connection pool
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s

# Kafka (required). The stack publishes its broker to the host on 29092.
KAFKA_BROKERS=localhost:29092
# The topic Debezium writes: <topic.prefix>.<schema>.<table>, fixed by
# docker/debezium/connector.json.
KAFKA_TOPIC=search.public.documents
KAFKA_CONSUMER_GROUP=near-realtime-search
# Messages the consumer could not index end up here. Defaults to
# KAFKA_TOPIC + ".dlq". Under Docker Compose the topic must already exist:
# kafka-init creates it and auto-creation is off.
KAFKA_DLQ_TOPIC=
KAFKA_WORKERS=10

# Retries before a message is dead-lettered (consumer only). The wait before
# attempt n is KAFKA_RETRY_INITIAL_BACKOFF x KAFKA_RETRY_MULTIPLIER^(n-1),
# capped at KAFKA_RETRY_MAX_BACKOFF: with these values 500ms, 1s, 2s, 4s.
# Total tries per message, including the first; 1 disables retrying.
KAFKA_RETRY_MAX_ATTEMPTS=5
KAFKA_RETRY_INITIAL_BACKOFF=500ms
KAFKA_RETRY_MAX_BACKOFF=30s
# How much each wait grows; 1 keeps it constant.
KAFKA_RETRY_MULTIPLIER=2

# OpenSearch (URL required)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=documents

# Qdrant (URL required). Must be the gRPC endpoint, port 6334 by default,
# not the REST endpoint on 6333.
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
# Dimension of stored vectors. Defaults to EMBEDDING_DIMENSION and must match
# it, because Qdrant rejects vectors of any other length.
QDRANT_VECTOR_SIZE=768

# Indexing (consumer only)
INDEXING_WORKERS=10
# Messages buffered across all workers
INDEXING_QUEUE_SIZE=1000
INDEXING_BATCH_SIZE=100

# Embedding provider. Both services need the API key: the consumer embeds
# documents and the API embeds search queries.
# gemini, or fake for deterministic local vectors: no API key, no network,
# no cost. The fake provider is for tests and local runs only; the services
# refuse to start with it when APP_ENV is production.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# gemini-embedding-2 supports 128-3072; 768, 1536 and 3072 are recommended.
# Changing it, or the model, means re-embedding every stored document.
EMBEDDING_DIMENSION=768
# Upper bound on one embedding request, network round trip included
EMBEDDING_TIMEOUT=10s

# Hybrid search (API only)
# Results returned when a request asks for no particular number
SEARCH_DEFAULT_LIMIT=10
# Most results one request may ask for
SEARCH_MAX_LIMIT=50
# Results fetched from each of OpenSearch and Qdrant before fusion; at least
# SEARCH_MAX_LIMIT and at most 100
SEARCH_CANDIDATE_LIMIT=50
# Reciprocal Rank Fusion constant
RRF_K=60
# Upper bound on one search request; must be shorter than HTTP_WRITE_TIMEOUT
SEARCH_TIMEOUT=5s
