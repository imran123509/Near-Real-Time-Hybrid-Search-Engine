# Keep secrets and local state out of the build context: "COPY . ." would
# otherwise copy .env, API key included, into the build stage.
.env
.env.*
!.env.example

.git
.gitignore
.dockerignore
docker-compose.yml
Dockerfile

# Not needed to compile the services.
docker/
scripts/
benchmarks/
*.md
*.test
*.out
/bin/
